{
  "name": "@nwrks/uikit",
  "version": "1.0.20",
  "type": "module",
  "repository": "https://github.com/Hisuika/Web.AppKit",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist/ node_modules/.cache/",
    "build": "rm -rf dist/ && mkdir dist/ && tsc && vite build",
    "deploy": "npm version patch --force && npm run build && npm publish --access public",
    "lint": "eslint . --fix",
    "bung": "node büng/src/bung.js"
  },
  "dependencies": {
    "@types/lodash": "^4.14.202",
    "@vitejs/plugin-react": "^6.2.1",
    "clsx": "^2.1.0",
    "lodash-es": "^4.17.21",
    "react-detect-click-outside": "^1.1.7",
    "styled-components": "^6.1.8"
  },
  "peerDependencies": {
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.10",
    "@types/prop-types": "^15.7.11",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/styled-components": "^5.1.34",
    "babel-loader": "^9.1.3",
    "bung": "file:./büng/",
    "globals": "^15.0.0",
    "prop-types": "^15.8.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "sass": "^1.70.0",
    "typescript": "^5.7.2",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^3.7.2"
  },
  "main": "./dist/uikit.umd.js",
  "module": "./dist/uikit.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/uikit.es.js",
      "require": "./dist/uikit.umd.js",
      "types": "./dist/index.d.ts"
    },
    "./styling": {
      "import": "./dist/style.css",
      "require": "./dist/style.css"
    }
  },
  "packageManager": "yarn@4.5.3",
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "core-js@3.41.0": true,
    "fsevents@2.3.3": true,
    "es5-ext@0.10.64": true,
    "esbuild@0.28.2": true
  }
}
