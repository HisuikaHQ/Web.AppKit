{
  "name": "@nwrks/uikit",
  "version": "1.0.20",
  "type": "module",
  "repository": "https://github.com/Hisuika/Web.AppKit",
  "license": "MIT",
  "scripts": {
    "clean": "rm -rf dist/ node_modules/.cache/ storybook-static/",
    "build": "rm -rf dist/ && tsc -p tsconfig.build.json && vite build",
    "typecheck": "tsc --noEmit",
    "deploy": "npm version patch --force && npm run build && npm publish --access public",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "bung": "node büng/src/bung.js"
  },
  "dependencies": {
    "clsx": "^2.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "styled-components": "^6.1.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.5.0",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/react-vite": "^10.6.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "bung": "file:./büng/",
    "eslint": "^10.14.0",
    "eslint-plugin-storybook": "^10.6.6",
    "globals": "^17.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.108.1",
    "storybook": "^10.6.6",
    "styled-components": "^6.6.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.7",
    "vite-plugin-dts": "^5.1.2"
  },
  "main": "./dist/uikit.umd.js",
  "module": "./dist/uikit.es.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/uikit.es.js",
      "require": "./dist/uikit.umd.js"
    },
    "./styling": "./dist/uikit.css"
  },
  "packageManager": "yarn@4.5.3",
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
